# eo-style, dark. Values mirror ../tokens.json.
# plt.style.use("path/to/eo-style-guide/matplotlib/eo-dark.mplstyle")

font.family: sans-serif
font.sans-serif: Roboto, Helvetica Neue, Arial, DejaVu Sans
font.monospace: Roboto Mono, Menlo, DejaVu Sans Mono
font.size: 10
text.color: ffffff

figure.facecolor: 000000
figure.edgecolor: 000000
figure.dpi: 120
savefig.facecolor: 000000
savefig.edgecolor: 000000
savefig.dpi: 200
savefig.bbox: tight

axes.facecolor: 0a0a0a
axes.edgecolor: 4d4d4d
axes.labelcolor: ffffff
axes.labelsize: 9
axes.titlesize: 10
axes.titleweight: medium
axes.titlelocation: left
axes.titlepad: 10
axes.titlecolor: ffffff
axes.spines.top: False
axes.spines.right: False
axes.spines.left: False
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['2f62e8', 'e03a2f', '0f9a66', 'a45ee0', '1a9cc0', 'd9539a'])

grid.color: 1f1f1f
grid.linestyle: (0, (2, 4))
grid.linewidth: 0.8

xtick.color: 8f8f8f
ytick.color: 8f8f8f
xtick.labelsize: 8.5
ytick.labelsize: 8.5
ytick.left: False
xtick.direction: out

lines.linewidth: 2.0
lines.solid_capstyle: round
lines.solid_joinstyle: round
lines.markersize: 6

patch.edgecolor: none
patch.linewidth: 0

legend.frameon: False
legend.fontsize: 8.5
legend.labelcolor: 8f8f8f
legend.handlelength: 1.0
legend.handleheight: 1.0
